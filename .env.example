# PostgreSQL Database url
DATABASE_URL="postgresql://username:password@localhost:5432/gmvmaxos?schema=public"

# Redis Server URL
REDIS_URL="redis://localhost:6379"

# TikTok Integration Secrets
MOCK_TIKTOK_API="true"
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""

# Telegram Bot configurations for alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# JWT signing key
JWT_SECRET="generate-a-secure-random-key"
PORT=3000
NODE_ENV="production"

# Admin Authentication Settings
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-password"

